{
  "name": "omni-studio",
  "description": "OmniStudio — 本地大模型一体化桌面工作台 | A desktop workstation for local LLMs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kunpengtalk/OmniStudio.git",
    "directory": "apps/studio"
  },
  "bin": {
    "omi": "bin/omi.ts",
    "omni": "./src/cli/omni.ts"
  },
  "scripts": {
    "start": "vite build && electrobun dev",
    "typecheck": "tsc --noEmit",
    "dev": "electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run start --watch\"",
    "db:generate": "drizzle-kit generate",
    "hmr": "vite --port 5173",
    "test": "bun test",
    "test:smoke": "bun scripts/migrations-smoke.ts && bun scripts/memory-smoke.ts && bun scripts/kb-smoke.ts && bun scripts/kb-chat-smoke.ts && bun scripts/kb-rerank-smoke.ts && bun scripts/kb-access-smoke.ts && bun scripts/kb-governance-smoke.ts && bun scripts/video-gen-smoke.ts && bun scripts/backup-smoke.ts && bun scripts/omi-docs-smoke.ts",
    "build:dev": "vite build && electrobun build",
    "build:canary": "vite build && electrobun build --env=canary",
    "build:stable": "vite build && electrobun build --env=stable"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.35",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@img/sharp-darwin-arm64": "^0.34.5",
    "@img/sharp-libvips-darwin-arm64": "^1.2.4",
    "@napi-rs/canvas": "^0.1.96",
    "@napi-rs/canvas-darwin-arm64": "^0.1.97",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "^5.90.21",
    "@truto/turndown-plugin-gfm": "^1.0.2",
    "ai": "^6.0.116",
    "ansi-to-react": "^6.2.6",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "electrobun": "^1.16.0",
    "katex": "^0.16.38",
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "^5.5.207",
    "radix-ui": "^1.4.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "^4.0.7",
    "sharp": "^0.34.5",
    "shiki": "^4.0.2",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "turndown": "^7.2.2",
    "tw-animate-css": "^1.4.0",
    "typebox": "1.3.7",
    "yaml": "^2.9.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "^0.183.1",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "catalog:",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.31.9",
    "happy-dom": "^20.14.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
